{
  "name": "@vento/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hono + oRPC API",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "infra:check": "node --env-file-if-exists=../../.env src/infra/check-cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:migrate:test": "node --env-file-if-exists=../../.env src/db/migrate.ts --test",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "1.19.18",
    "@orpc/server": "1.16.2",
    "@vento/shared": "workspace:*",
    "better-auth": "1.7.20",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
