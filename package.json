{
  "name": "vento-hotels",
  "private": true,
  "description": "Hotel management platform for Nigerian hotel groups",
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @vento/web e2e",
    "db:up": "docker compose up -d --wait",
    "db:generate": "pnpm --filter @vento/api db:generate",
    "db:migrate": "pnpm --filter @vento/api db:migrate && pnpm --filter @vento/api db:migrate:test",
    "db:seed": "echo \"db:seed: the demo seed arrives in Stage 0, brick 10\" && exit 1",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait",
    "db:status": "pnpm --filter @vento/api infra:check",
    "db:studio": "pnpm --filter @vento/api db:studio",
    "features": "node --env-file-if-exists=.env apps/api/src/features/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
