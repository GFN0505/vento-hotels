# /opt/vento/.env on each server (template: deploy/server.env.example). Copy this file to the server
# the filled file. Generate secrets with: openssl rand -base64 32

# The address people use, e.g. app.venthotels.ng or staging.venthotels.ng. Its DNS A record must
# point at this server before the first start, so Caddy can get the HTTPS certificate.
DOMAIN=

# staging or production. Production refuses the demo seed and unreleased modules.
DEPLOY_ENV=staging

# Database password (letters and numbers only, 32+ characters).
POSTGRES_PASSWORD=

# Signs sessions and tokens: 32+ random characters.
BETTER_AUTH_SECRET=

# File storage (Cloudflare R2): guest IDs, PDFs and uploads.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Backups (a separate, private R2 bucket with its own key, so the app can't delete its backups).
BACKUP_BUCKET=
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Background jobs run in the API process.
JOBS_ENABLED=true

# Error tracking (Sentry). Leave empty to keep it off.
SENTRY_DSN=

# Staging only: the demo group's password, for `docker compose run --rm api node src/seed/cli.ts`.
DEMO_PASSWORD=
