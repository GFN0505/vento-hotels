# One address for the app and the API (decision 0019). Caddy gets and renews the HTTPS certificate
# for {$DOMAIN} by itself. `localhost` uses Caddy's own local certificate, for trying the stack.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(), microphone=()"
		-Server
	}

	@api path /api/* /rpc/* /health
	handle @api {
		reverse_proxy api:3010 {
			header_up X-Request-Id {http.request.uuid}
		}
	}

	handle {
		root * /srv
		# The page and the service worker must always be fresh, or an update never arrives.
		@fresh path / /index.html /sw.js
		header @fresh Cache-Control "no-cache"
		# Built files carry their content in their name, so they can be kept for a year.
		@built path /assets/*
		header @built Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	# No access log here: full URLs can hold sign-in tokens. The API logs each request without them.
}
