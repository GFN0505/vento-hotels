# Copy to .env and fill in. Never commit .env: this repository is public.
# Each brick that needs a new setting documents it here.

NODE_ENV=development

# Ports for local development
API_PORT=3010
WEB_PORT=5180

# Local Postgres from docker-compose.yml (`pnpm db:up`). Port 5433 so it never clashes with
# other projects' Postgres on 5432. These are local placeholder credentials, not secrets.
DATABASE_URL=postgres://vento_hotels:vento_hotels@localhost:5433/vento_hotels
# Separate database for automated tests (created by docker/postgres-init.sql).
TEST_DATABASE_URL=postgres://vento_hotels:vento_hotels@localhost:5433/vento_hotels_test

# Local S3-compatible storage from docker-compose.yml (RustFS). In production this is Cloudflare R2.
# Console in the browser: http://localhost:9101/rustfs/console/ (sign in with the keys below).
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vento-hotels-local
S3_SECRET_ACCESS_KEY=vento-hotels-local-secret
S3_BUCKET=vento-hotels-local

# Sign-in (Better Auth). Generate your own secret: openssl rand -base64 32
# Never reuse this value outside your machine, and never commit a real one.
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
# The address people open in the browser (used in email links). The web app forwards /api and /rpc to
# the API, so this is the web origin, not the API port (decision 0019).
BETTER_AUTH_URL=http://localhost:5180
WEB_ORIGIN=http://localhost:5180
# Optional, local only: save emails as files in this folder instead of printing them (git-ignored).
EMAIL_OUTBOX_DIR=.data/outbox
