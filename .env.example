# Copy to .env and fill in. Never commit .env: this repository is public.
# Each brick that needs a new setting documents it here.

NODE_ENV=development
# Which server this is: local, staging or production (servers set it in /opt/vento/.env).
DEPLOY_ENV=local

# Ports for local development
API_PORT=3010
WEB_PORT=5180

# Local Postgres from docker-compose.yml (`pnpm db:up`). Port 5433 so it never clashes with
# other projects' Postgres on 5432. These are local placeholder credentials, not secrets.
DATABASE_URL=postgres://vento_hotels:vento_hotels@localhost:5433/vento_hotels
# Separate database for automated tests (created by docker/postgres-init.sql).
TEST_DATABASE_URL=postgres://vento_hotels:vento_hotels@localhost:5433/vento_hotels_test

# Local S3-compatible storage from docker-compose.yml (RustFS). In production this is Cloudflare R2
# (region "auto"). Console in the browser: http://localhost:9101/rustfs/console/ (sign in with the
# keys below). Locally the API creates the bucket on start and lets the web app upload to it (hotel
# logos). Without the keys and bucket the API still runs, with uploads switched off.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vento-hotels-local
S3_SECRET_ACCESS_KEY=vento-hotels-local-secret
S3_BUCKET=vento-hotels-local
# Guest ID photos and scans go to a separate private bucket (decision 0031). Defaults to
# "<S3_BUCKET>-private"; locally the API creates it on start, with no CORS.
# S3_PRIVATE_BUCKET=vento-hotels-local-private

# Encrypts guest ID, passport and visa numbers in the database (decision 0031): 32 random bytes,
# base64 (openssl rand -base64 32). Required on staging and production. Locally, a fixed
# development key is used when ALLOW_DEV_GUEST_DATA_KEY=true (the dev, seed and test scripts set
# it; never for real guests, and ignored unless DEPLOY_ENV=local and NODE_ENV isn't production).
# Without either, the API refuses to start. To rotate: put the old key in
# GUEST_DATA_PREVIOUS_KEYS (comma-separated) and the new one here; old rows still read.
ALLOW_DEV_GUEST_DATA_KEY=true
# GUEST_DATA_KEY=
# GUEST_DATA_PREVIOUS_KEYS=

# Sign-in (Better Auth). Generate your own secret: openssl rand -base64 32
# Never reuse this value outside your machine, and never commit a real one.
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
# The address people open in the browser (used in email links). The web app forwards /api and /rpc to
# the API, so this is the web origin, not the API port (decision 0019).
BETTER_AUTH_URL=http://localhost:5180
WEB_ORIGIN=http://localhost:5180
# Optional, local only: save emails as files in this folder instead of printing them (git-ignored).
EMAIL_OUTBOX_DIR=.data/outbox

# Development only: turn on every module, released or not, so unreleased work can be built and
# tried (decision 0021). Never set in production; the API refuses to start with it there.
VENTO_ALL_FEATURES=true

# Demo seed (`pnpm db:seed`, development and sales demos only): every demo person signs in with
# this password. Made-up data; never used in production.
DEMO_PASSWORD=Kora-demo-2026!

# Background jobs (pg-boss, in the same Postgres; decision 0025). On by default; set to false for a
# process that should only answer requests.
JOBS_ENABLED=true

# Logs: debug, info (default), warn or error. JSON lines, never personal data.
# LOG_LEVEL=info

# Error tracking (Sentry). Leave unset locally; set per environment when hosting is chosen.
# SENTRY_DSN=
# VITE_SENTRY_DSN=
